{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "rangeStrategy": "bump",
    "customManagers": [
        {
            "description": "DotSlash tool pins. Stub digests are regenerated by update_dotslash_stubs.mjs.",
            "customType": "regex",
            "depTypeTemplate": "devcontainer.dotslash",
            "managerFilePatterns": [
                ".devcontainer/dotslash-tools.mjs"
            ],
            "matchStrings": [
                "//\\s*renovate:\\s*(datasource=(?<datasource>.*?) )?depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s*\\n\\s*version: \"(?<currentValue>.*)\""
            ]
        },
        {
            "description": "Bazel http_archive pins. Asset names and digests are regenerated by update_bazel_git.mjs.",
            "customType": "regex",
            "managerFilePatterns": [
                "MODULE.bazel"
            ],
            "matchStrings": [
                "#\\s*renovate:\\s*(datasource=(?<datasource>.*?) )?depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s*\\n\\s*\\w+ = \"(?<currentValue>.*)\""
            ]
        }
    ],
    "packageRules": [
        {
            "matchDatasources": [
                "*"
            ],
            "minimumReleaseAge": "3 days",
            "description": "Wait 3 days before updating. Safeguard against supply chain attacks and (for npm) unpublishing of packages."
        },
        {
            "matchManagers": [
                "npm"
            ],
            "matchDepTypes": [
                "pnpm.overrides"
            ],
            "enabled": false,
            "description": "Overrides are managed manually for security and/or workaround reasons."
        },
        {
            "matchManagers": [
                "npm"
            ],
            "matchDepTypes": [
                "pnpm.catalog.vscode"
            ],
            "matchDepNames": [
                "@types/node"
            ],
            "enabled": false,
            "description": "@types/node needs to be kept in sync with VSCode minimum version."
        },
        {
            "matchManagers": [
                "npm"
            ],
            "matchDepNames": [
                "@eslint/js",
                "eslint",
                "typescript-eslint"
            ],
            "groupName": "eslint",
            "description": "Update ESLint packages together, since they release at the same time."
        },
        {
            "matchManagers": [
                "custom.regex",
                "npm"
            ],
            "matchDepNames": [
                "pnpm"
            ],
            "groupName": "pnpm",
            "description": "Update all pnpm package manager references together."
        },
        {
            "matchManagers": [
                "custom.regex"
            ],
            "matchDepNames": [
                "nodejs/node"
            ],
            "allowedVersions": "/^v\\d*[02468]\\./",
            "description": "Only update NodeJS to LTS (even major) versions."
        },
        {
            "matchManagers": [
                "custom.regex",
                "npm"
            ],
            "matchDepNames": [
                "nodejs/node",
                "@types/node"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "groupName": "nodejs",
            "description": "Update NodeJS and @types/node major versions together to keep them in sync."
        },
        {
            "matchManagers": [
                "bazel-module"
            ],
            "matchDepNames": [
                "rules_rust",
                "rules_rust_wasm_bindgen"
            ],
            "groupName": "rules_rust",
            "description": "Update rules_rust and rules_rust_wasm_bindgen together, as they need to be kept in sync."
        },
        {
            "matchManagers": [
                "npm"
            ],
            "matchDepNames": [
                "renovate"
            ],
            "schedule": [
                "* * 1-7,15-21 * 1"
            ],
            "description": "Reduce update rate of packages with high-frequency publishes to 1st and 3rd Monday of each month."
        }
    ]
}
