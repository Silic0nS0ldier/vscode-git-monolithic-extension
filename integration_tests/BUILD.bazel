load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@bazel_skylib//lib:selects.bzl", "selects")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_itest//:itest.bzl", "itest_service")
load("@rules_oci_runtime//lib:defs.bzl", "runc_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("//build_defs/lint:linters.bzl", "eslint_test", "shellcheck_test")
load(":defs.bzl", "BROWSERLESS_TOKEN", "LINUX_ONLY", "scm_itest")

npm_link_all_packages(name = "node_modules")

selects.config_setting_group(
    name = "linux_x86_64",
    match_all = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

selects.config_setting_group(
    name = "linux_arm64",
    match_all = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

filegroup(
    name = "code_server_binary",
    srcs = select({
        ":linux_x86_64": ["@code_server_linux_x64//:bin/code-server"],
        ":linux_arm64": ["@code_server_linux_arm64//:bin/code-server"],
        "//conditions:default": [],
    }),
    target_compatible_with = LINUX_ONLY,
)

# code-server resolves its Node runtime and the bundled VS Code build relative to the
# launcher script, so the rest of the distribution has to be staged alongside it.
filegroup(
    name = "code_server_dist",
    srcs = select({
        ":linux_x86_64": ["@code_server_linux_x64//:dist"],
        ":linux_arm64": ["@code_server_linux_arm64//:dist"],
        "//conditions:default": [],
    }),
    target_compatible_with = LINUX_ONLY,
)

sh_library(
    name = "service_scripts",
    srcs = [
        "code-server.sh",
        "workspace-fixture.sh",
    ] + glob(["fixtures/*.sh"]),
)

sh_binary(
    name = "workspace_fixture",
    srcs = ["workspace-fixture.sh"],
    data = [
        "//build_defs/git_bin:dist",
        "//build_defs/git_bin:git",
    ],
)

sh_binary(
    name = "code_server",
    srcs = ["code-server.sh"],
    data = [
        ":code_server_binary",
        ":code_server_dist",
        "//extension/vsix:git_monolithic",
    ],
    target_compatible_with = LINUX_ONLY,
)

runc_binary(
    name = "browserless_chromium",
    # The default session timeout is 30s, which is shorter than a full suite run.
    env = {
        "TIMEOUT": "600000",
        "TOKEN": BROWSERLESS_TOKEN,
    },
    image = "@browserless_chromium",
    target_compatible_with = LINUX_ONLY,
    strict_xattrs = False,
)

itest_service(
    name = "browserless_chromium_service",
    # The container does not inherit the host environment, so the assigned port has to
    # travel as a launcher flag rather than through `env`.
    args = [
        "--env",
        "PORT=$${PORT}",
    ],
    autoassign_port = True,
    expected_start_duration = "10s",
    exe = ":browserless_chromium",
    http_health_check_address = "http://127.0.0.1:$${PORT}/meta?token=" + BROWSERLESS_TOKEN,
    target_compatible_with = LINUX_ONLY,
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig"],
)

ts_project(
    name = "lib_tests",
    srcs = glob(["src/**/*.ts"]) + ["package.json"],
    out_dir = "dist",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/node",
        ":node_modules/playwright-core",
    ],
)

scm_itest(
    name = "commit",
    entry_point = "dist/commit.test.js",
    fixture = "fixtures/commit.sh",
)

scm_itest(
    name = "refs",
    entry_point = "dist/refs.test.js",
    fixture = "fixtures/refs.sh",
)

scm_itest(
    name = "scm",
    entry_point = "dist/scm.test.js",
    fixture = "fixtures/scm.sh",
)

js_test(
    name = "code_server_pin_drift_test",
    size = "small",
    args = [
        "$(rootpath //:module_bazel)",
        "$(rootpath //extension/vsix:manifest)",
    ],
    data = [
        "//:module_bazel",
        "//extension/vsix:manifest",
    ],
    entry_point = "check-code-server-pin.mjs",
)

shellcheck_test(
    name = "shellcheck",
    srcs = [":service_scripts"],
)

eslint_test(
    name = "eslint",
    srcs = [":lib_tests"],
)

