{
    "indentWidth": 4,
    "lineWidth": 120,
    "useTabs": false,
    "newLineKind": "lf",
    "excludes": [
        "**/node_modules",
        "**/target",
        "**/.bazel",
        "**/.pnpm-store",
        "pnpm-lock.yaml",
        "Cargo.lock",
        "MODULE.bazel.lock",
        "multitool.lock.json",
        ".devcontainer/devcontainer-lock.json"
    ],
    "exec": {
        "cwd": "${configDir}",
        "commands": [
            {
                "command": "rustfmt --edition 2024",
                "exts": ["rs"]
            },
            {
                "command": "buildifier -lint=off -path={{file_path}}",
                "exts": ["bazel", "bzl"]
            }
        ]
    },
    "plugins": [
        "https://plugins.dprint.dev/typescript-0.96.1.wasm",
        "https://plugins.dprint.dev/json-0.23.0.wasm",
        "https://plugins.dprint.dev/markdown-0.22.1.wasm",
        "https://plugins.dprint.dev/exec-0.7.3.json@a7898d5f1897e77bff474cec3d948c3ec3a7f455e32de2cc60c8adb9a5dd24aa"
    ]
}
