load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//build_defs/lint:linters.bzl", "eslint_test")

npm_link_all_packages(name = "node_modules")

js_binary(
    name = "bin",
    data = [
        "package.json",
        ":lib",
    ],
    entry_point = ":dist/main.js",
    visibility = ["//visibility:public"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["src/**/*.test.ts"],
    ) + ["package.json"],
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    tsconfig = ":tsconfig",
    visibility = [":__pkg__"],
    deps = [
        ":node_modules/@rollup/plugin-commonjs",
        ":node_modules/@rollup/plugin-json",
        ":node_modules/@rollup/plugin-node-resolve",
        ":node_modules/@types/node",
        ":node_modules/cleye",
        ":node_modules/rollup",
        ":node_modules/rollup-plugin-sourcemaps2",
    ],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__pkg__"],
    deps = ["//:tsconfig"],
)

ts_project(
    name = "lib_tests",
    srcs = glob(["src/**/*.test.ts"]) + ["package.json"],
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":lib",
        ":node_modules/@types/node",
        ":node_modules/rollup",
    ],
)

js_test(
    name = "typescript_helper_warnings_test",
    size = "small",
    args = ["--test"],
    data = [
        "package.json",
        ":lib_tests",
    ],
    entry_point = "dist/typescript-helper-warnings-plugin.test.js",
)

js_test(
    name = "warnings_test",
    size = "small",
    args = ["--test"],
    data = [
        "package.json",
        ":lib_tests",
    ],
    entry_point = "dist/warnings.test.js",
)

eslint_test(
    name = "eslint",
    size = "small",
    srcs = [
        ":lib",
        ":lib_tests",
    ],
)
