"""
Rollup bundle rule.
"""

load("@aspect_rules_js//js:defs.bzl", "js_run_binary")

def _rollup_bundle(name, srcs, entry_points, external_modules, **kwargs):
    # type: (string, list[string], list[string], list[string]) -> None
    replace_modules = kwargs.pop("replace_modules", {})
    args = ["--out-dir", name + "_"]
    outs = []

    # Handle entry points
    for entry_point in entry_points:
        args.append("--entry-point")
        args.append(entry_point)
        outs.append("%s_/%s" % (name, entry_point.split("/")[-1]))

    # Handle external modules
    for external_module in external_modules:
        args.append("--external-module")
        args.append(external_module)

    replace_module_srcs = []
    package_depth = len(native.package_name().split("/")) if native.package_name() else 0
    relative_execroot = "../" * (3 + package_depth)
    for replacement_file, module_path in replace_modules.items():
        args.extend([
            "--replace-module",
            "%s=%s$(location %s)" % (module_path, relative_execroot, str(replacement_file)),
        ])
        replace_module_srcs.append(replacement_file)

    # Remove `None` values generated by `macro`
    clean_kwargs = {}
    for key, value in kwargs.items():
        if value != None:
            clean_kwargs[key] = value

    js_run_binary(
        name = name,
        tool = "//build_defs/rollup_bundle:bin",
        args = args,
        srcs = srcs + replace_module_srcs,
        outs = outs,
        out_dirs = [
            "%s_/chunks" % name,
            "%s_/assets" % name,
            # Kept apart so packaging the JS does not pick them up.
            "%s_/sourcemaps" % name,
        ],
        chdir = native.package_name(),
        mnemonic = "RollupBundle",
        # Removes an intermediary `_js_library` target that may fail to find toolchains
        use_execroot_entry_point = False,
        silent_on_success = False,
        **clean_kwargs
    )

rollup_bundle = macro(
    implementation = _rollup_bundle,
    inherit_attrs = "common",
    attrs = {
        "srcs": attr.label_list(
            mandatory = True,
            allow_files = True,
            doc = "Source files to be considered for bundle inclusion.",
        ),
        "entry_points": attr.string_list(
            mandatory = True,
            configurable = False,
            doc = "Roots from which to start bundling.",
        ),
        "external_modules": attr.string_list(
            configurable = False,
            doc = "External modules that should not (or cannot) be bundled.",
        ),
        "replace_modules": attr.label_keyed_string_dict(
            allow_files = True,
            configurable = False,
            doc = "Replacement files mapped to module paths resolved from the bundle's working directory.",
        ),
    },
    doc = """
        Create a JS bundle using an opinionated Rollup configuration.
        Entry-point output files use their basenames. `replace_modules` maps replacement-file labels to resolved
        module paths; replacements retain the original module IDs and fail if a module path is not found.
        Source maps are written to `<name>_/sourcemaps` without a `sourceMappingURL`
        comment, and follow those of the inputs back to their original sources.
        Circular dependency warnings wholly within node_modules are suppressed;
        cycles involving project sources and other warnings remain visible.
    """,
)
