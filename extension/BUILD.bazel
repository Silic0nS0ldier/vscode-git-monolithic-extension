load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//extension:ava/package_json.bzl", "bin")
load("//build_defs/lint:linters.bzl", "eslint_test")
load("//build_defs/rollup_bundle:rollup_bundle.bzl", "rollup_bundle")

# Functions of `src/tracing.ts` that the bundles pass call sites to.
LOG_FUNCTIONS = [
    "trace",
    "debug",
    "info",
    "warn",
    "error",
]

npm_link_all_packages(name = "node_modules")

js_library(
    name = "manifest",
    srcs = ["package.json"],
    visibility = ["//integration_tests:__pkg__"],
)

js_run_binary(
    name = "command_names",
    srcs = ["//extension/vsix:manifest"],
    args = [
        "--manifest",
        "$(rootpath //extension/vsix:manifest)",
        "--prefix",
        "git_monolithic.",
        "--from",
        "extension/vsix/package.json",
        "--update",
        "'bazel run //extension:update_command_names'",
    ],
    stdout = "command-names.gen.ts",
    tool = "//packages/vscode-manifest:generate_command_names",
)

write_source_files(
    name = "update_command_names",
    files = {
        "src/commands/command-names.gen.ts": ":command_names",
    },
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/**/*.stub.ts",
        ],
    ) + ["package.json"],
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    source_map = True,
    tsconfig = ":tsconfig",
    visibility = [
        "//integration_tests:__pkg__",
    ],
    deps = [
        ":node_modules/@types/node",
        ":node_modules/@types/vscode",
        ":node_modules/@vscode/diff",
        ":node_modules/@vscode/extension-telemetry",
        ":node_modules/core-js-pure",
        ":node_modules/ignore",
        ":node_modules/just-debounce",
        ":node_modules/monolithic-git-interop",
        ":node_modules/onetime",
        ":node_modules/watcher",
    ],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__pkg__"],
    deps = ["//:tsconfig"],
)

rollup_bundle(
    name = "bundle",
    srcs = [":lib"],
    callsite_functions = LOG_FUNCTIONS,
    callsite_module = "dist/tracing.js",
    entry_points = [
        "dist/main.js",
        "dist/askpass-main.js",
    ],
    external_modules = [
        "vscode",
    ],
    unsafe_treeshake = True,
    visibility = [
        "//extension/vsix:__pkg__",
        "//integration_tests:__pkg__",
        "//integration_tests/electron_host:__pkg__",
    ],
)

js_run_binary(
    name = "pruning_test_selection",
    srcs = ["//extension/vsix:manifest"],
    args = [
        "--manifest",
        "$(rootpath //extension/vsix:manifest)",
        "--prefix",
        "git_monolithic.",
        "--from",
        "extension/vsix/package.json",
        "--update",
        "test",
        "--selection",
        "--select",
        "cherryPick",
    ],
    stdout = "pruning-test-selection.js",
    tool = "//packages/vscode-manifest:generate_command_names",
)

rollup_bundle(
    name = "pruning_test_bundle",
    srcs = [":lib"],
    callsite_functions = LOG_FUNCTIONS,
    callsite_module = "dist/tracing.js",
    command_implementations = "dist/commands/implementations",
    command_selection = ":pruning_test_selection",
    entry_points = ["dist/main.js"],
    external_modules = ["vscode"],
    tags = ["manual"],
    unsafe_treeshake = True,
)

js_test(
    name = "command_pruning_bundle_test",
    args = ["$(rootpath :pruning_test_bundle_/main.js)"],
    data = [":pruning_test_bundle_/main.js"],
    entry_point = "src/commands/command-pruning-bundle.test.mjs",
)

js_test(
    name = "bundle_not_pruned_test",
    args = ["$(rootpath :bundle_/main.js)"],
    data = [":bundle_/main.js"],
    entry_point = "src/commands/bundle-not-pruned.test.mjs",
)

js_test(
    name = "bundle_callsites_test",
    args = ["$(rootpath :bundle_/main.js)"],
    data = [
        ":bundle_/main.js",
        ":node_modules/acorn",
    ],
    entry_point = "src/bundle-callsites.test.mjs",
)

ts_project(
    name = "lib_tests",
    srcs = glob(["src/**/*.test.ts"]) + glob(
        ["src/**/*.stub.ts"],
        allow_empty = True,
    ) + ["package.json"],
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    source_map = True,
    tsconfig = ":tsconfig",
    deps = [
        ":lib",
        ":node_modules/@types/node",
        ":node_modules/ava",
        ":node_modules/monolithic-vscode-manifest",
    ],
)

bin.ava_test(
    name = "tests",
    size = "small",
    args = ["-t"],
    chdir = package_name(),
    data = [
        "package.json",
        ":lib_tests",
        # Read by src/manifest.test.ts
        "//extension/vsix:manifest",
        "//extension/vsix:itest_manifest",
        "//extension/vsix:nls",
    ] + glob(["src/**/*.ts"]),
)

eslint_test(
    name = "eslint",
    size = "small",
    srcs = [
        ":lib",
        ":lib_tests",
    ],
)
