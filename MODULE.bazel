# code-server hosts the extension for `//integration_tests`. Upstream VS Code cannot run
# headless (Electron), and gitpod/openvscode-server stopped at 1.105.1 in October 2025,
# below the `engines.vscode` floor in //extension/vsix:package.json.
_CODE_SERVER_BUILD_FILE = """\
exports_files(["bin/code-server"])

filegroup(
    name = "dist",
    srcs = glob(["**"], exclude = ["bin/code-server"]),
    visibility = ["//visibility:public"],
)
"""

# Source of truth for the VS Code version this repo targets: `engines.vscode` in
# //extension/vsix:package.json and the `@types/vscode` pin in //extension:package.json are
# derived from this pin by update_bazel_code_server.mjs, which also refreshes the digests
# below. Guarded by //integration_tests:code_server_pin_drift_test.
# Keep the renovate annotation directly above the assignment; the custom manager in
# .github/renovate.json cannot see past an intervening comment line.
# renovate: datasource=github-releases depName=coder/code-server
_CODE_SERVER_RELEASE = "4.143.1"

_CODE_SERVER_URL_PREFIX = "https://github.com/coder/code-server/releases/download/v" + _CODE_SERVER_RELEASE + "/code-server-" + _CODE_SERVER_RELEASE + "-"

http_archive(
    name = "code_server_linux_x64",
    build_file_content = _CODE_SERVER_BUILD_FILE,
    sha256 = "614877cf71005f14ea252bd2d9b1c12237cf7d73681ef150f0dff7f13849fdb5",
    strip_prefix = "code-server-" + _CODE_SERVER_RELEASE + "-linux-amd64",
    url = _CODE_SERVER_URL_PREFIX + "linux-amd64.tar.gz",
)

http_archive(
    name = "code_server_linux_arm64",
    build_file_content = _CODE_SERVER_BUILD_FILE,
    sha256 = "51481a891754dc2585b86d007aec24ac675453fc5ef6cfa346c4462449277384",
    strip_prefix = "code-server-" + _CODE_SERVER_RELEASE + "-linux-arm64",
    url = _CODE_SERVER_URL_PREFIX + "linux-arm64.tar.gz",
)

