# Portable git builds from GitHub Desktop, used by `//packages/git` integration tests.
# Building git from source (the BCR `git` module) also builds OpenSSL and BoringSSL, which
# dominated the build: ~2400 of ~3600 action CPU-seconds for ~8s of tests.
_DUGITE_BUILD_FILE = """\
exports_files(["bin/git"])

filegroup(
    name = "dist",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "bin/git",
            # Unused by these tests, and ~106MB of the ~139MB payload.
            "libexec/git-core/git-credential-manager",
            "libexec/git-core/git-lfs",
            "libexec/git-core/*.so",
            "share/locale/**",
        ],
    ),
    visibility = ["//visibility:public"],
)
"""

# renovate: datasource=github-releases depName=desktop/dugite-native versioning=regex:^v(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)-(?<build>\d+)$
_DUGITE_RELEASE = "v2.53.0-3"

# Asset names embed the git source commit, which is not derivable from the release tag.
# Kept in sync with _DUGITE_RELEASE by .github/workflows/update_bazel_git.mjs.
_DUGITE_ASSET_VERSION = "v2.53.0-f49d009"

_DUGITE_URL_PREFIX = "https://github.com/desktop/dugite-native/releases/download/" + _DUGITE_RELEASE + "/dugite-native-" + _DUGITE_ASSET_VERSION + "-"

http_archive(
    name = "dugite_linux_x64",
    build_file_content = _DUGITE_BUILD_FILE,
    sha256 = "b3a85433c8dfde76d21b90938ad2f971653deff4340b1b4d347258c63250eafc",
    url = _DUGITE_URL_PREFIX + "ubuntu-x64.tar.gz",
)

