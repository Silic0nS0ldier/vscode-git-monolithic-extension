# code-server hosts the extension for `//integration_tests`. Upstream VS Code cannot run
# headless (Electron), and gitpod/openvscode-server stopped at 1.105.1 in October 2025,
# below the `engines.vscode` floor in //extension/vsix:package.json.
_CODE_SERVER_BUILD_FILE = """\
exports_files(["bin/code-server"])

filegroup(
    name = "dist",
    srcs = glob(["**"], exclude = ["bin/code-server"]),
    visibility = ["//visibility:public"],
)
"""

