# code-server hosts the extension for `//integration_tests`. Upstream VS Code cannot run
# headless (Electron), and gitpod/openvscode-server stopped at 1.105.1 in October 2025,
# below the `engines.vscode` floor in //extension/vsix:package.json.
_CODE_SERVER_BUILD_FILE = """\
exports_files(["bin/code-server"])

filegroup(
    name = "dist",
    srcs = glob(["**"], exclude = ["bin/code-server"]),
    visibility = ["//visibility:public"],
)
"""

# Source of truth for the VS Code version this repo targets: `engines.vscode` in
# //extension/vsix:package.json and the `@types/vscode` pin in //extension:package.json are
# derived from this pin by update_bazel_code_server.mjs, which also refreshes the digests
# below. Guarded by //integration_tests:code_server_pin_drift_test.
# Keep the renovate annotation directly above the assignment; the custom manager in
# .github/renovate.json cannot see past an intervening comment line.
# renovate: datasource=github-releases depName=coder/code-server
_CODE_SERVER_RELEASE = "4.140.0"

_CODE_SERVER_URL_PREFIX = "https://github.com/coder/code-server/releases/download/v" + _CODE_SERVER_RELEASE + "/code-server-" + _CODE_SERVER_RELEASE + "-"

http_archive(
    name = "code_server_linux_x64",
    build_file_content = _CODE_SERVER_BUILD_FILE,
    sha256 = "864c5d01c808ade57e4d12c708717be7a187219fded60428f263b9e2da9f6b48",
    strip_prefix = "code-server-" + _CODE_SERVER_RELEASE + "-linux-amd64",
    url = _CODE_SERVER_URL_PREFIX + "linux-amd64.tar.gz",
)

http_archive(
    name = "code_server_linux_arm64",
    build_file_content = _CODE_SERVER_BUILD_FILE,
    sha256 = "ae4b07153f2037b06d24749bc8004221fcbf3ffe317038401be0452f541bf200",
    strip_prefix = "code-server-" + _CODE_SERVER_RELEASE + "-linux-arm64",
    url = _CODE_SERVER_URL_PREFIX + "linux-arm64.tar.gz",
)

register_toolchains(
    "//build_defs/rust_wasm_bindgen:toolchain",
    "@llvm//toolchain:all",
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "devcontainers_base_ubuntu",
    digest = "sha256:91eff046d5c12318fc98e59258982b87ba896c467427ed8b5dab5a02107a5db7",
    # Follows latest LTS release
    image = "mcr.microsoft.com/devcontainers/base:ubuntu",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)
oci.pull(
    name = "browserless_chromium",
    digest = "sha256:5252f0d0bb947acec41c39f4507fab4af15f9f9337267ca1a97fa026197df8e6",
    image = "ghcr.io/browserless/chromium",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
    tag = "v2.56.4",
)
use_repo(
    oci,
    "browserless_chromium",
    "browserless_chromium_linux_amd64",
    "browserless_chromium_linux_arm64",
    "devcontainers_base_ubuntu",
    "devcontainers_base_ubuntu_linux_amd64",
    "devcontainers_base_ubuntu_linux_arm64",
)

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")

# Derived from the `devcontainers_base_ubuntu` build time by update_devcontainer_apt_snapshot.mjs,
# so packages already in the base image resolve to the versions it ships. Guarded by
# //.devcontainer:image_test.
apt.sources_list(
    architectures = [
        "amd64",
        "arm64",
    ],
    components = ["main"],
    suites = [
        "resolute",
        "resolute-security",
        "resolute-updates",
    ],
    types = ["deb"],
    uris = ["https://snapshot.ubuntu.com/ubuntu/20261009T185710Z"],
)
apt.install(
    dependency_set = "devcontainer_apt",
    mergedusr = True,
    packages = [
        # FUSE for `runc_binary`, see //.devcontainer:fuse.conf
        "fuse3",
        # Libraries required by Electron in //integration_tests/electron_host:electron_host_smoke_test
        "libasound2t64",
        "libatk-bridge2.0-0t64",
        "libatk1.0-0t64",
        "libatspi2.0-0t64",
        "libcairo2",
        "libcups2t64",
        "libdbus-1-3",
        "libgbm1",
        "libglib2.0-0t64",
        "libgtk-3-0t64",
        "libnss3",
        "libpango-1.0-0",
        "libxcomposite1",
        "libxdamage1",
        "libxfixes3",
        "libxkbcommon0",
        "libxrandr2",
    ],
    suites = [
        "resolute",
        "resolute-security",
        "resolute-updates",
    ],
)
use_repo(apt, "devcontainer_apt")

