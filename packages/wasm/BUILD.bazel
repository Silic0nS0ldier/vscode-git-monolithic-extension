load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@crates//:defs.bzl", "all_crate_deps")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_rust//rust:defs.bzl", "rust_shared_library", "rust_test")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")
load("//build_defs/lint:linters.bzl", "eslint_test")

npm_link_all_packages(name = "node_modules")

rust_shared_library(
    name = "wasm_lib",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    target_compatible_with = [
        "@platforms//cpu:wasm32",
        "@platforms//os:none",
    ],
    deps = all_crate_deps(normal = True),
)

# Built for the host rather than `:wasm_lib`, whose wasm32 constraints leave nothing able to
# execute the resulting binary. `#[wasm_bindgen]` degrades to a plain function off wasm32.
rust_test(
    name = "wasm_lib_test",
    size = "small",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    deps = all_crate_deps(normal = True),
)

# wasm-bindgen writes its outputs into a directory named after the target, so the target is
# named for the position the glue needs to occupy under `dist`.
rust_wasm_bindgen(
    name = "dist/wasm",
    out_name = "wasm",
    target = "web",
    wasm_file = ":wasm_lib",
)

# Small ESM wrapper that source-phase-imports the sidecar `.wasm` file and
# re-exports the wasm-bindgen glue. The wasm is compiled by the runtime at
# module load time and passed to `initSync` synchronously, so consumers can
# use exports without an explicit init step.
#
# Note: the corresponding Rollup plugin recognises `.wasm` imports and copies
# the file next to the JS chunks in the output bundle.
write_file(
    name = "mod_js",
    out = "dist/mod.js",
    content = [
        "import source W from \"./wasm/wasm_bg.wasm\";",
        "import { initSync } from \"./wasm/wasm.js\";",
        "export * from \"./wasm/wasm.js\";",
        "initSync({ module: W });",
        "",
    ],
)

# Re-exports the types generated by wasm-bindgen. The `wasm.js` glue file
# carries a `@ts-self-types="./wasm.d.ts"` comment so TypeScript follows the
# sibling `.d.ts` for the actual declarations.
write_file(
    name = "mod_dts",
    out = "dist/mod.d.ts",
    content = [
        "export * from \"./wasm/wasm.js\";",
        "",
    ],
)

# The package's whole build output, exposed to editors and non-Bazel tooling as a single
# `packages/wasm/dist` symlink by `../bazelify-dist.sh`.
js_library(
    name = "dist",
    srcs = [
        ":dist/wasm",
        ":mod_dts",
        ":mod_js",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":dist",
    ],
    include_types = True,
    visibility = ["//visibility:public"],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__pkg__"],
    deps = ["//:tsconfig"],
)

ts_project(
    name = "lib_tests",
    srcs = glob(["src/**/*.test.ts"]) + ["package.json"],
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":dist",
        ":node_modules/@types/node",
    ],
)

TESTS = [(
    file.removeprefix("src/").removesuffix(".test.ts"),
    file.replace("src/", "dist/").replace(".ts", ".js"),
) for file in glob(["src/**/*.test.ts"])]

test_suite(
    name = "tests",
    tests = [":" + test_name + "_test" for (test_name, _) in TESTS],
)

[
    js_test(
        name = test_name + "_test",
        size = "small",
        args = ["--test"],
        data = [
            "package.json",
            ":lib_tests",
        ],
        entry_point = entry_point,
    )
    for (test_name, entry_point) in TESTS
]

eslint_test(
    name = "eslint",
    size = "small",
    srcs = [":lib_tests"],
)
