load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//packages/git:ava/package_json.bzl", "bin")
load("//build_defs/lint:linters.bzl", "eslint_test")

npm_link_all_packages(name = "node_modules")

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    exclude_srcs_patterns = ["tsconfig.json"],
    include_types = True,
    visibility = ["//visibility:public"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/**/*.stub.ts",
        ],
    ) + ["package.json"],
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/node",
        ":node_modules/@types/which",
        ":node_modules/compare-versions",
        ":node_modules/get-stream",
        ":node_modules/monolithic-git-wasm",
        ":node_modules/which",
    ],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__pkg__"],
    deps = ["//:tsconfig"],
)

ts_project(
    name = "lib_tests",
    srcs = glob(
        [
            "src/**/*.test.ts",
            "src/**/*.stub.ts",
        ],
        exclude = ["src/**/*.it.*.ts"],
    ) + ["package.json"],
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":lib",
        ":node_modules/ava",
        ":node_modules/into-stream",
    ],
)

bin.ava_test(
    name = "tests",
    size = "small",
    chdir = package_name(),
    data = [
        "package.json",
        ":lib_tests",
    ],
)

ts_project(
    name = "lib_integration_stubs",
    srcs = glob(["src/**/*.it.stub.ts"]) + ["package.json"],
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":lib",
        ":node_modules/@bazel/runfiles",
    ],
)

INTEGRATION_TESTS = [(
    "integration_test/" + file,
    file,
    file.replace("src/", "dist/").replace(".ts", ".js"),
) for file in glob(["src/**/*.it.test.ts"])]

test_suite(
    name = "integration_tests",
    tests = [":" + test_name for (test_name, _, _) in INTEGRATION_TESTS],
)

[
    ts_project(
        name = test_name + "_lib",
        srcs = [
            "package.json",
            src,
        ],
        declaration = True,
        out_dir = "dist",
        root_dir = "src",
        tsconfig = ":tsconfig",
        deps = [
            ":lib",
            ":lib_integration_stubs",
        ],
    )
    for (test_name, src, _) in INTEGRATION_TESTS
]

[
    js_test(
        name = test_name,
        size = "small",
        args = [
            "--test",
        ],
        data = [
            "package.json",
            ":" + test_name + "_lib",
            "//build_defs/git_bin:dist",
            "//build_defs/git_bin:git",
        ],
        entry_point = entry_point,
        env = {
            # The repository holding git is platform dependent, so its runfiles path
            # cannot be hardcoded in the test sources.
            "GIT_BIN_RLOCATION": "$(rlocationpath //build_defs/git_bin:git)",
        },
        no_copy_to_bin = [
            "//build_defs/git_bin:dist",
            "//build_defs/git_bin:git",
        ],
    )
    for (test_name, _, entry_point) in INTEGRATION_TESTS
]

eslint_test(
    name = "eslint",
    srcs = [
        ":lib",
        ":lib_integration_stubs",
        ":lib_tests",
    ] + [":" + test_name + "_lib" for (test_name, _, _) in INTEGRATION_TESTS],
)
