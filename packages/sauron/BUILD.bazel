load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//packages/sauron:ava/package_json.bzl", "bin")
load("//build_defs/lint:linters.bzl", "eslint_test")

npm_link_all_packages(name = "node_modules")

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    exclude_srcs_patterns = ["tsconfig.json"],
    include_types = True,
    visibility = ["//visibility:public"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/**/*.stub.ts",
            "src/bench/**",
        ],
    ) + ["package.json"],
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/node",
        ":node_modules/ignore",
        ":node_modules/monolithic-git-interop",
    ],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__pkg__"],
    deps = ["//:tsconfig"],
)

ts_project(
    name = "lib_tests",
    srcs = glob(
        [
            "src/**/*.test.ts",
            "src/**/*.stub.ts",
        ],
        exclude = [
            "src/**/*.it.*.ts",
            "src/bench/**",
        ],
    ) + ["package.json"],
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":lib",
        ":node_modules/ava",
    ],
)

bin.ava_test(
    name = "tests",
    size = "small",
    chdir = package_name(),
    data = [
        "package.json",
        ":lib_tests",
    ],
)

INTEGRATION_TESTS = [(
    "integration_test/" + file,
    file,
    file.replace("src/", "dist/").replace(".ts", ".js"),
) for file in glob(["src/**/*.it.test.ts"])]

test_suite(
    name = "integration_tests",
    tests = [":" + test_name for (test_name, _, _) in INTEGRATION_TESTS],
)

[
    ts_project(
        name = test_name + "_lib",
        srcs = [
            "package.json",
            src,
        ],
        declaration = True,
        out_dir = "dist",
        root_dir = "src",
        tsconfig = ":tsconfig",
        deps = [":lib"],
    )
    for (test_name, src, _) in INTEGRATION_TESTS
]

[
    js_test(
        name = test_name,
        size = "small",
        args = ["--test"],
        data = [
            "package.json",
            ":" + test_name + "_lib",
        ],
        entry_point = entry_point,
    )
    for (test_name, _, entry_point) in INTEGRATION_TESTS
]

ts_project(
    name = "bench_lib",
    srcs = glob(["src/bench/**/*.ts"]) + ["package.json"],
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":lib",
        ":node_modules/@types/node",
        ":node_modules/ignore",
        ":node_modules/monolithic-git-interop",
        ":node_modules/watcher",
    ],
)

BENCH_DATA = [
    "package.json",
    "src/bench/expected.json",
    ":bench_lib",
]

# Deterministic performance comparison against `watcher`. Fails when results leave the expected range,
# whether better or worse. See src/bench/README.md.
js_test(
    name = "bench",
    size = "medium",
    data = BENCH_DATA,
    entry_point = "dist/bench/main.js",
    target_compatible_with = ["@platforms//os:linux"],
)

js_binary(
    name = "bench_update",
    args = ["--update"],
    data = BENCH_DATA,
    entry_point = "dist/bench/main.js",
    target_compatible_with = ["@platforms//os:linux"],
)

eslint_test(
    name = "eslint",
    size = "small",
    srcs = [
        ":bench_lib",
        ":lib",
        ":lib_tests",
    ] + [":" + test_name + "_lib" for (test_name, _, _) in INTEGRATION_TESTS],
)
