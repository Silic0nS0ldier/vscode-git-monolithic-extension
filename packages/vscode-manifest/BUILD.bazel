load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//packages/vscode-manifest:ava/package_json.bzl", "bin")
load("//build_defs/lint:linters.bzl", "eslint_test")

npm_link_all_packages(name = "node_modules")

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    exclude_srcs_patterns = ["tsconfig.json"],
    include_types = True,
    visibility = ["//visibility:public"],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["src/**/*.test.ts"],
    ) + ["package.json"],
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/node",
        ":node_modules/typescript",
    ],
)

js_binary(
    name = "generate_command_names",
    data = [":lib"],
    entry_point = "dist/generate-command-names.js",
    visibility = ["//extension:__pkg__"],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__pkg__"],
    deps = ["//:tsconfig"],
)

ts_project(
    name = "lib_tests",
    srcs = glob(["src/**/*.test.ts"]) + ["package.json"],
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":lib",
        ":node_modules/ava",
        ":node_modules/typescript",
    ],
)

bin.ava_test(
    name = "tests",
    size = "small",
    chdir = package_name(),
    data = [
        "package.json",
        ":lib_tests",
    ],
)

eslint_test(
    name = "eslint",
    size = "small",
    srcs = [
        ":lib",
        ":lib_tests",
    ],
)
