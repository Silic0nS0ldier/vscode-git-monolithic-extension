Keep Android's default toolchain registrations local to rules_android's own build.

All three registrations are unconditional upstream. Bazel loads their packages during toolchain
resolution even when nothing builds Android, materialising the entire rules_android repository.
The SDK package also brings in the androidsdk repository and runs host SDK discovery.

Mark the registrations dev-only so rules_android can still use them in its own build without
imposing them on non-Android consumers. Consumers that need these toolchains can register them
explicitly in their root module.

Not yet raised upstream.

--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -22,9 +22,9 @@
 bazel_dep(name = "bazel_features", version = "1.48.1")
 bazel_dep(name = "rules_robolectric", version = "4.14.1.2", repo_name = "robolectric")
 
-register_toolchains("//toolchains/android:all")
+register_toolchains("//toolchains/android:all", dev_dependency = True)
 
-register_toolchains("//toolchains/android_sdk:all")
+register_toolchains("//toolchains/android_sdk:all", dev_dependency = True)
 
 # go-related dependency setup
 bazel_dep(name = "rules_go", version = "0.59.0", repo_name = "io_bazel_rules_go")
@@ -201,7 +201,7 @@
 android_sdk_repository_extension = use_extension("//rules/android_sdk_repository:rule.bzl", "android_sdk_repository_extension")
 use_repo(android_sdk_repository_extension, "androidsdk")
 
-register_toolchains("@androidsdk//:sdk-toolchain", "@androidsdk//:all")
+register_toolchains("@androidsdk//:sdk-toolchain", "@androidsdk//:all", dev_dependency = True)
 
 flag_alias(
     name = "android_fixed_resource_neverlinking",
