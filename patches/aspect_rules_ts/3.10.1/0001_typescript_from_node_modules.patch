+
+def _runfiles_relative_path(label):
+    """Path from `<this repo>/node_modules/typescript` to `label` within a runfiles tree."""
+
+    # `../..` escapes `node_modules/typescript` to the runfiles root, from which every repo is a
+    # sibling directory. The main repo is always `_main` there, whatever the workspace is called.
+    repo = label.workspace_name or "_main"
+    segments = [segment for segment in [repo, label.package, label.name] if segment]
+    return "../../" + "/".join(segments)
+
