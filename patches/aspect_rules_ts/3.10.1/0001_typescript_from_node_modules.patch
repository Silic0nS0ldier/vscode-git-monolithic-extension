diff --git a/ts/private/unresolved_symlink.bzl b/ts/private/unresolved_symlink.bzl
new file mode 100644
index 0000000..b0ae9dc
--- /dev/null
+++ b/ts/private/unresolved_symlink.bzl
@@ -0,0 +1,26 @@
+"""Dangling symlink used to expose a package under the name TypeScript tooling expects."""
+
+def _unresolved_symlink_impl(ctx):
+    out = ctx.actions.declare_symlink(ctx.attr.link_name)
+    ctx.actions.symlink(output = out, target_path = ctx.attr.target_path)
+    return [DefaultInfo(files = depset([out]), runfiles = ctx.runfiles([out]))]
+
+unresolved_symlink = rule(
+    doc = """Declares a symlink whose target is never resolved by Bazel.
+
+    `tsc` and the options validator both resolve TypeScript by the bare specifier `typescript`, so
+    a package linked under any other name (an npm alias, for instance) has to be reachable under
+    that name too. The link is relative and dangling at analysis time; it only has to resolve
+    within the runfiles tree of the consuming binary.""",
+    implementation = _unresolved_symlink_impl,
+    attrs = {
+        "link_name": attr.string(
+            doc = "Path of the symlink to create, relative to this package.",
+            mandatory = True,
+        ),
+        "target_path": attr.string(
+            doc = "Path the symlink points at, relative to the symlink itself.",
+            mandatory = True,
+        ),
+    },
+)
