+// waitUntilDone blocks until the goroutine waiting on the process has recorded its exit.
+// A process group can be gone (ESRCH) before that happens, and callers of Stop read
+// ProcessState as soon as it returns.
+func (s *ServiceInstance) waitUntilDone() {
+	for !s.isDone() {
+		time.Sleep(5 * time.Millisecond)
+	}
