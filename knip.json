{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        ".": {
            "entry": [
                "integration_tests/electron_host/check-electron-pin.mjs",
                "integration_tests/electron_host/load-check.mjs"
            ],
            "ignoreDependencies": [
                "@typescript/native",
                "renovate"
            ]
        },
        "extension": {
            "entry": [
                "src/main.ts",
                "src/askpass-main.ts"
            ],
            "project": [
                "src/**/*.ts"
            ]
        },
        "packages/git": {
            "entry": [
                "src/api/**/mod.ts"
            ],
            "project": [
                "src/**/*.ts"
            ]
        },
        "packages/wasm": {
            "entry": [
                "wasm.test.js"
            ],
            "ignoreUnresolved": [
                "./mod.js"
            ]
        },
        "build_defs/rollup_bundle": {
            "entry": [
                "src/main.ts"
            ]
        },
        "build_defs/vsix_package": {
            "entry": [
                "src/main.ts"
            ]
        }
    },
    "ignoreDependencies": [
        "vscode"
    ]
}
