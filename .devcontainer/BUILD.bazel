load("@aspect_rules_js//js:defs.bzl", "js_image_layer")
load("@jq.bzl//jq:jq.bzl", "jq")
load("@npm//:knip/package_json.bzl", knip_bin = "bin")
load("@rules_distroless//distroless:defs.bzl", "flatten")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_oci_runtime//lib:defs.bzl", "runc_binary")
load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@tar.bzl", "mutate", "tar")
load("//build_defs/lint:linters.bzl", "shellcheck_test")

tar(
    name = "dotslash",
    srcs = select({
        "@platforms//cpu:x86_64": ["@dotslash_amd64//:dotslash"],
        "@platforms//cpu:aarch64": ["@dotslash_arm64//:dotslash"],
    }),
    mutate = mutate(
        package_dir = "usr/bin",
    ),
)

tar(
    name = "dotslash_stubs",
    srcs = [
        "dotslash/bazel",
        "dotslash/buildifier",
        "dotslash/buildozer",
        "dotslash/dprint",
        "dotslash/gh",
        "dotslash/jscpd",
        "dotslash/node",
        "dotslash/pnpm",
        "dotslash/rustup",
        "dotslash/starpls",
        "dotslash/unused-deps",
    ],
    mutate = mutate(
        package_dir = "usr/bin",
        strip_prefix = ".devcontainer/dotslash",
    ),
)

# knip has no standalone release, so ship the npm package with its own node runtime.
knip_bin.knip_binary(
    name = "knip_launcher",
)

js_image_layer(
    name = "knip_layers",
    binary = ":knip_launcher",
    root = "/usr/lib/knip",
)

tar(
    name = "knip_shim",
    srcs = ["knip"],
    mutate = mutate(
        package_dir = "usr/bin",
        strip_prefix = ".devcontainer",
    ),
)

tar(
    name = "rustup_symlinks",
    mtree = [
        "usr uid=0 gid=0 mode=0755 time=1672560000 type=dir",
        "usr/bin uid=0 gid=0 mode=0755 time=1672560000 type=dir",
        "usr/bin/cargo uid=0 gid=0 mode=0755 time=1672560000 type=link link=rustup",
        "usr/bin/cargo-clippy uid=0 gid=0 mode=0755 time=1672560000 type=link link=rustup",
        "usr/bin/cargo-fmt uid=0 gid=0 mode=0755 time=1672560000 type=link link=rustup",
        "usr/bin/cargo-miri uid=0 gid=0 mode=0755 time=1672560000 type=link link=rustup",
        "usr/bin/clippy-driver uid=0 gid=0 mode=0755 time=1672560000 type=link link=rustup",
        "usr/bin/rust-analyzer uid=0 gid=0 mode=0755 time=1672560000 type=link link=rustup",
        "usr/bin/rust-gdb uid=0 gid=0 mode=0755 time=1672560000 type=link link=rustup",
        "usr/bin/rust-lldb uid=0 gid=0 mode=0755 time=1672560000 type=link link=rustup",
        "usr/bin/rustc uid=0 gid=0 mode=0755 time=1672560000 type=link link=rustup",
        "usr/bin/rustdoc uid=0 gid=0 mode=0755 time=1672560000 type=link link=rustup",
        "usr/bin/rustfmt uid=0 gid=0 mode=0755 time=1672560000 type=link link=rustup",
    ],
)

# `@devcontainer_apt//:flat` is avoided because it replaces /var/lib/dpkg/status, hiding the
# base image's packages from apt. Maintainer scripts do not run.
flatten(
    name = "apt_packages",
    deduplicate = True,
    tars = ["@devcontainer_apt//:packages"],
)

# `<arch> <package> <version>` per resolved package, for image_checks.sh.
jq(
    name = "apt_versions",
    srcs = ["@devcontainer_apt//:lock.json"],
    out = "apt_versions.txt",
    args = ["--raw-output"],
    filter = '.packages | keys[] | capture("/[^/]+/(?<name>[^:]+):(?<arch>[^=]+)=(?<version>.+)$") | "\\(.arch) \\(.name) \\(.version)"',
)

# fuse3's postinst, which does not run here, is what makes `fusermount3` setuid.
genrule(
    name = "fusermount3",
    srcs = ["@devcontainer_apt//fuse3:data"],
    outs = ["fusermount3.bin"],
    cmd = "$(BSDTAR_BIN) -xOf $< ./usr/bin/fusermount3 > $@",
    toolchains = ["@bsd_tar_toolchains//:resolved_toolchain"],
)

# Without `user_allow_other`, `fusermount3` refuses the auto-unmounting mount `runc_binary` asks
# for, so every interrupted `bazel test` leaves a mount behind. The mount point sits in a 0700
# directory, so no other user gains access.
tar(
    name = "fuse",
    srcs = [
        "fuse.conf",
        ":fusermount3",
    ],
    mtree = [
        "etc/fuse.conf uid=0 gid=0 mode=0644 time=1672560000 type=file content=$(execpath fuse.conf)",
        "usr/bin/fusermount3 uid=0 gid=0 mode=4755 time=1672560000 type=file content=$(execpath :fusermount3)",
    ],
)

oci_image(
    name = "image",
    base = "@devcontainers_base_ubuntu",
    tars = [
        ":apt_packages",
        ":fuse",
        ":dotslash",
        ":dotslash_stubs",
        ":knip_layers",
        ":knip_shim",
        ":rustup_symlinks",
    ],
)

oci_image_index(
    name = "image_index",
    images = [":image"],
    platforms = [
        ":linux_amd64",
        ":linux_arm64",
    ],
)

oci_push(
    name = "push_image",
    image = ":image_index",
    remote_tags = ["latest"],
    repository = "ghcr.io/silic0ns0ldier/vscode-git-monolithic-extension/devcontainer",
)

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

runc_binary(
    name = "container",
    image = ":image",
)

sh_library(
    name = "image_test_scripts",
    srcs = [
        "image_checks.sh",
        "image_test.sh",
    ],
)

sh_library(
    name = "knip_shim_script",
    srcs = ["knip"],
)

sh_test(
    name = "image_test",
    size = "small",
    srcs = ["image_test.sh"],
    data = [
        "image_checks.sh",
        ":apt_versions",
        ":container",
    ],
    env = {
        "APT_VERSIONS": "$(rlocationpath :apt_versions)",
        "CHECKS": "$(rlocationpath image_checks.sh)",
        "CONTAINER": "$(rlocationpath :container)",
    },
)

shellcheck_test(
    name = "shellcheck",
    size = "small",
    srcs = [
        ":image_test_scripts",
        ":knip_shim_script",
    ],
)
