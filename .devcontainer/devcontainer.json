{
    "image": "ghcr.io/silic0ns0ldier/vscode-git-monolithic-extension/devcontainer:latest",
    "privileged": true,
    "customizations": {
        "vscode": {
            "extensions": [
                "bazelbuild.vscode-bazel",
                "github.vscode-github-actions"
            ],
            "settings": {
                "bazel.codeLens.enable": true,
                "bazel.lsp.command": "starpls",
                "bazel.lsp.args": ["server"]
            }
        }
    },
    "initializeCommand": {
        "gh-cli-auth": "gh auth token > .git/__gh_token || true"
    },
    "postStartCommand": {
        "gh-cli-auth": "test -s .git/__gh_token && gh auth login --with-token < .git/__gh_token || true"
    }
}
